# Frontend → payment backend wiring.
#
# Set this to the Function URL of the `create-payment-link` Lambda, which is
# printed after the first backend deploy (also in amplify_outputs.json as
# custom.paymentApiUrl). In the Amplify console add it as an environment
# variable named VITE_PAYMENT_API_URL so the frontend build picks it up.
#
# Example:
# VITE_PAYMENT_API_URL=https://abc123def.lambda-url.us-east-1.on.aws/
VITE_PAYMENT_API_URL=
